# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=gasguard
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_SSL=false
DATABASE_MAX_QUERY_TIME=1000
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=10000

# Application Configuration
PORT=3000
NODE_ENV=development

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# RBAC Configuration
# Maximum failed login attempts before account lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
# Account lockout duration in minutes
ACCOUNT_LOCKOUT_MINUTES=30

# Archive Upload Limits
# Maximum compressed archive size in bytes (default: 10 MiB)
ARCHIVE_MAX_BYTES=10485760
# Maximum total uncompressed size in bytes (default: 50 MiB)
ARCHIVE_MAX_UNCOMPRESSED_BYTES=52428800
# Maximum number of entries in the archive (default: 5000)
ARCHIVE_MAX_ENTRIES=5000
# Maximum compression ratio (uncompressed/compressed) to guard against zip bombs (default: 100)
ARCHIVE_MAX_COMPRESSION_RATIO=100
